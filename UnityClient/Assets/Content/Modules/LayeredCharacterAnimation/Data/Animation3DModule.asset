  m_Script: {fileID: 11500000, guid: ed0f4a08819bca64c9c58234f5a7c14d, type: 3}
  m_Name: Animation3DModule
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.ModuleDefinitionSO
  localizationKey: animation3dmodule
  category: 0
  categoryLabel: Simulation Module
  categoryLabelRu: "\u0421\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C"
  moduleName: Layered Character Animation
  moduleNameRu: "\u0421\u043B\u043E\u0438\u0441\u0442\u0430\u044F \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430"
  thesis: Show how one humanoid model can run, shoot, or combine both through Animator
    layers and an upper-body AvatarMask.
  thesisRu: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u043A\u0430\u043A
    \u043E\u0434\u043D\u0430 humanoid-\u043C\u043E\u0434\u0435\u043B\u044C \u043C\u043E\u0436\u0435\u0442
    \u0431\u0435\u0436\u0430\u0442\u044C, \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C
    \u0438\u043B\u0438 \u0441\u043E\u0432\u043C\u0435\u0449\u0430\u0442\u044C \u043E\u0431\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0447\u0435\u0440\u0435\u0437
    Animator layers \u0438 upper-body AvatarMask."
  description: 'Interactive character-animation module focused on a common game-dev
    mechanic: keeping locomotion active while a combat action plays on the upper
    body.'
  descriptionRu: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u043F\u0440\u043E \u0447\u0430\u0441\u0442\u0443\u044E
    game-dev \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0443: locomotion \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439, \u043F\u043E\u043A\u0430 combat
    action \u0438\u0433\u0440\u0430\u0435\u0442 \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0442\u0435\u043B\u0430."
  problemStatement: Full-body clips are easy to preview, but action games need composition.
    The interesting architecture is separating locomotion ownership from upper-body
    actions.
  problemStatementRu: "Full-body \u043A\u043B\u0438\u043F\u044B \u043B\u0435\u0433\u043A\u043E
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E,
    \u043D\u043E action-\u0438\u0433\u0440\u0430\u043C \u043D\u0443\u0436\u043D\u0430
    \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044F. \u0412\u0430\u0436\u043D\u0430\u044F
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430 \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
    \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u0435 locomotion \u0438 upper-body
    actions."
  webGlPresetNote: Use Solo/Squad/Crowd presets for browser-safe previews. The goal
    is readability of layer mixing, not pushing thousands of skinned meshes.
  webGlPresetNoteRu: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    \u043F\u0440\u0435\u0441\u0435\u0442\u044B \u0421\u043E\u043B\u043E/\u0413\u0440\u0443\u043F\u043F\u0430/\u0422\u043E\u043B\u043F\u0430
    \u0434\u043B\u044F browser-safe preview. \u0426\u0435\u043B\u044C \u2014 \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0441\u0442\u044C
    layer mixing, \u0430 \u043D\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 skinned
    meshes."
  activeItemLabel: animated actors
  activeItemLabelRu: "\u0430\u043D\u0438\u043C\u0438\u0440\u0443\u0435\u043C\u044B\u0445
    \u0430\u043A\u0442\u0451\u0440\u043E\u0432"
