  m_Script: {fileID: 11500000, guid: ed0f4a08819bca64c9c58234f5a7c14d, type: 3}
  m_Name: ObjectPoolingModule
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.ModuleDefinitionSO
  localizationKey: objectpoolingmodule
  category: 1
  categoryLabel: Architecture Pattern Module
  categoryLabelRu: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0439
    \u043F\u0430\u0442\u0442\u0435\u0440\u043D"
  moduleName: Object Pooling
  moduleNameRu: "\u041F\u0443\u043B \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432"
  thesis: Show how the same visual outcome changes when object lifetime is reused
    instead of churned.
  thesisRu: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043A\u0430\u043A
    \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0439
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F,
    \u043A\u043E\u0433\u0434\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u043F\u0435\u0440\u0435\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F,
    \u0430 \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u044E\u0442\u0441\u044F \u0438
    \u0443\u0434\u0430\u043B\u044F\u044E\u0442\u0441\u044F \u0437\u0430\u043D\u043E\u0432\u043E."
  description: Comparison between naive instantiation churn and explicit pooled reuse
    for repeated visual emissions.
  descriptionRu: "\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043D\u0430\u0438\u0432\u043D\u043E\u0433\u043E
    churn \u0447\u0435\u0440\u0435\u0437 instantiation \u0438 \u044F\u0432\u043D\u043E\u0433\u043E
    \u043F\u0435\u0440\u0435\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
    \u043F\u0443\u043B \u0434\u043B\u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0445\u0441\u044F
    \u044D\u043C\u0438\u0441\u0441\u0438\u0439."
  problemStatement: Repeated spawn and despawn loops create allocation and lifecycle
    cost that often stays hidden until load spikes. This module isolates object reuse
    as a first-class production pattern.
  problemStatementRu: "\u041F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0435\u0441\u044F
    \u0446\u0438\u043A\u043B\u044B \u0441\u043F\u0430\u0443\u043D\u0430 \u0438 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F
    \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u043F\u043E \u0430\u043B\u043B\u043E\u043A\u0430\u0446\u0438\u044F\u043C \u0438
    \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E\u043C\u0443 \u0446\u0438\u043A\u043B\u0443,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0439 \u0434\u043E \u043F\u0438\u043A\u043E\u0432\u044B\u0445
    \u043D\u0430\u0433\u0440\u0443\u0437\u043E\u043A. \u042D\u0442\u043E\u0442 \u043C\u043E\u0434\u0443\u043B\u044C
    \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442 \u043F\u0435\u0440\u0435\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u043A\u0430\u043A \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439
    production-\u043F\u0430\u0442\u0442\u0435\u0440\u043D."
  webGlPresetNote: Use 500 or 2000 in browser. Higher presets are meant to expose
    churn differences and may not stay smooth on every machine.
  webGlPresetNoteRu: "\u0412 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    500 \u0438\u043B\u0438 2000. \u0411\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0435
    \u043F\u0440\u0435\u0441\u0435\u0442\u044B \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u044B
    \u0434\u043B\u044F \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u0438
    \u0440\u0430\u0437\u043D\u0438\u0446\u044B \u0432 churn \u0438 \u043C\u043E\u0433\u0443\u0442
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0435\u0440\u043E\u0432\u043D\u043E
    \u043D\u0430 \u0447\u0430\u0441\u0442\u0438 \u043C\u0430\u0448\u0438\u043D."
  activeItemLabel: visible projectiles
  activeItemLabelRu: "\u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432"
