  m_Name: AISystemModule
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.ModuleDefinitionSO
  localizationKey: aisystemmodule
  category: 0
  categoryLabel: Simulation Module
  categoryLabelRu: "\u0421\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C"
  moduleName: AI System
  moduleNameRu: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0418\u0418"
  thesis: Compare decision models over the same shared world state.
  thesisRu: "\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043C\u043E\u0434\u0435\u043B\u0435\u0439
    \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u0439
    \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u0438 \u0442\u043E\u043C \u0436\u0435
    \u043E\u0431\u0449\u0435\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
    \u043C\u0438\u0440\u0430."
  description: 'Interactive comparison of decision-making approaches for crowds of
    simple agents: FSM, Utility AI and Behavior Tree.'
  descriptionRu: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435
    \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u043E\u0432
    \u043A \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u044E \u0440\u0435\u0448\u0435\u043D\u0438\u0439
    \u0434\u043B\u044F \u0442\u043E\u043B\u043F \u043F\u0440\u043E\u0441\u0442\u044B\u0445
    \u0430\u0433\u0435\u043D\u0442\u043E\u0432: \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442, utility-\u0418\u0418 \u0438 \u0434\u0435\u0440\u0435\u0432\u043E
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F."
  problemStatement: AI crowds need more than believable behavior. The decision model
    also has to stay inspectable, predictable, and maintainable as agent count grows.
  problemStatementRu: "\u0422\u043E\u043B\u043F\u0430\u043C \u0418\u0418 \u043D\u0443\u0436\u043D\u043E
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0430\u0432\u0434\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0435
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435. \u041C\u043E\u0434\u0435\u043B\u044C
    \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u0439
    \u0434\u043E\u043B\u0436\u043D\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u043C\u043E\u0439, \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u043E\u0439
    \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u043E\u0439
    \u043F\u043E \u043C\u0435\u0440\u0435 \u0440\u043E\u0441\u0442\u0430 \u0447\u0438\u0441\u043B\u0430
    \u0430\u0433\u0435\u043D\u0442\u043E\u0432."
  webGlPresetNote: Use 500-2000 agents in browser and 5K on desktop. Presets scale
    full decision simulation while visible agents stay curated for readability.
  webGlPresetNoteRu: "\u0412 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    500\u20132000 \u0430\u0433\u0435\u043D\u0442\u043E\u0432, \u043D\u0430 desktop
    \u2014 5K. \u041F\u0440\u0435\u0441\u0435\u0442\u044B \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u044E\u0442
    \u043F\u043E\u043B\u043D\u0443\u044E \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044E
    \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u0439,
    \u0430 \u0432\u0438\u0434\u0438\u043C\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u0430\u0433\u0435\u043D\u0442\u043E\u0432 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u0440\u0430\u0434\u0438
    \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0441\u0442\u0438."
  activeItemLabel: visible agents
  activeItemLabelRu: "\u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u0430\u0433\u0435\u043D\u0442\u043E\u0432"
