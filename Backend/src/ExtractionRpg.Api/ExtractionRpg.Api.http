@ExtractionRpg.Api_HostAddress = http://localhost:5000

GET {{ExtractionRpg.Api_HostAddress}}/
Accept: application/json

###

GET {{ExtractionRpg.Api_HostAddress}}/health
Accept: application/json

###

POST {{ExtractionRpg.Api_HostAddress}}/api/auth/login-by-name
Content-Type: application/json

{
  "username": "AsdaRunner"
}

###

GET {{ExtractionRpg.Api_HostAddress}}/api/profile/me
Authorization: Bearer {{sessionToken}}
Accept: application/json

###

GET {{ExtractionRpg.Api_HostAddress}}/api/lobbies
Accept: application/json

###

POST {{ExtractionRpg.Api_HostAddress}}/api/lobbies
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{
  "name": "Forest Run",
  "maxPlayers": 4
}

###

POST {{ExtractionRpg.Api_HostAddress}}/api/lobbies/{{lobbyId}}/join
Authorization: Bearer {{sessionToken}}

###

POST {{ExtractionRpg.Api_HostAddress}}/api/lobbies/{{lobbyId}}/ready
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{
  "isReady": true
}

###

POST {{ExtractionRpg.Api_HostAddress}}/api/lobbies/{{lobbyId}}/start
Authorization: Bearer {{sessionToken}}

###
