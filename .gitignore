# =============================================================================
# ExtractionRPG product workspace
# Unity client: UnityClient/  |  Backend: Backend/  |  Site: Site/
# Keep Unity Assets/, Packages/, ProjectSettings/, and all .meta in git.
# =============================================================================

# --- Unity generated (UnityClient/) ---
UnityClient/[Ll]ibrary/
UnityClient/[Tt]emp/
UnityClient/[Oo]bj/
UnityClient/[Ll]ogs/
UnityClient/[Bb]uild/
UnityClient/[Bb]uilds/
UnityClient/[Mm]emoryCaptures/
UnityClient/[Rr]ecordings/
UnityClient/[Uu]ser[Ss]ettings/

# Legacy root Unity artifacts (opening repo root by mistake)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Bb]uild/
[Bb]uilds/
[Mm]emoryCaptures/
[Rr]ecordings/
[Uu]ser[Ss]ettings/

# Unity editor scratch / recovery / one-off test scenes
UnityClient/Assets/_Recovery/
UnityClient/Assets/_Recovery.meta
**/_Recovery/
**/_Recovery.meta
InitTestScene*.unity
InitTestScene*.unity.meta

# Agent / local debug dumps (do not commit)
debug-*.log
**/debug-*.log

# Local git-URL package experiments under Packages/ (not PackageCache)
# Includes CoplayDev MCP scratch clones (often have nested .git → IDE SCM noise)
UnityClient/Packages/_*/
UnityClient/Packages/_mcp-test/
**/Packages/_*/

# Unity generated files
sysinfo.txt
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity auto-generated IDE projects (regenerated by Editor under UnityClient/)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.rsuser
*.dotCover

# Backend: allow committed solution/projects when ASP.NET scaffold grows
!Backend/
!Backend/**/
!Backend/**/*.sln
!Backend/**/*.csproj
!Backend/Directory.Build.props
!Backend/Directory.Build.targets
!Backend/nuget.config

# --- .NET / Backend build output ---
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
# NuGet restore output (Backend only — avoid **/packages/; clashes with Unity Packages/ on Windows)
Backend/packages/

# ASP.NET local secrets (when Backend is implemented)
**/appsettings.*.json.local
**/secrets.json
*.pfx

# --- IDEs ---
.vs/
.vscode/
.idea/
*.sln.iml
.consulo/

# Test and coverage
TestResults/
artifacts/
coverage/
coverage-results/
CodeCoverage/
*.coverage
*.coveragexml

# Working captures (not shipped assets)
UnityClient/Docs/Screenshots/
UnityClient/Assets/Content/Screenshots/
Docs/Screenshots/

# Addressables / remote build output
ServerData/
UnityClient/Assets/AddressableAssetsData/WebGL.meta
UnityClient/Assets/AddressableAssetsData/WebGL/
Assets/AddressableAssetsData/WebGL.meta
Assets/AddressableAssetsData/WebGL/

# Portfolio site — generated WebGL export (rebuild via Unity + prepare-webgl-site.ps1)
Site/webgl/Build/
Site/webgl/StreamingAssets/
Site/webgl/TemplateData/
Site/webgl/index.html
Site/webgl/build-manifest.json

# Tooling scratch
.tmp-edge-profile/
crashlytics-build.properties

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local environment / secrets
.env
.env.*
!.env.example
