  m_Script: {fileID: 11500000, guid: ed0f4a08819bca64c9c58234f5a7c14d, type: 3}
  m_Name: InventoryModule
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.ModuleDefinitionSO
  localizationKey: 
  category: 0
  categoryLabel: Simulation Module
  categoryLabelRu: "\u0421\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C"
  moduleName: Inventory Systems
  moduleNameRu: "\u0421\u0438\u0441\u0442\u0435\u043C\u044B \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F"
  thesis: Compare object-rich slot ownership with packed slot processing under sustained
    transfer load.
  thesisRu: "\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u043E\u0433\u043E
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438 \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F
    \u0441\u043B\u043E\u0442\u0430\u043C\u0438 \u0441 \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u043E\u0439 \u0441\u043B\u043E\u0442\u043E\u0432
    \u043F\u043E\u0434 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0439
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430."
  description: Interactive inventory module focused on state mutation patterns, stack
    movement and the cost of per-slot ownership.
  descriptionRu: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F,
    \u0441\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043D\u0430 \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u0430\u0445 \u043C\u0443\u0442\u0430\u0446\u0438\u0438
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F, \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0438
    \u0441\u0442\u0430\u043A\u043E\u0432 \u0438 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
    \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F \u043B\u043E\u0433\u0438\u043A\u043E\u0439
    \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445
    \u0441\u043B\u043E\u0442\u043E\u0432."
  problemStatement: Inventory features often start as convenient object graphs and
    later become a hot data path once stacking, transfer rules and bulk operations
    grow.
  problemStatementRu: "\u0424\u0438\u0447\u0438 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F
    \u0447\u0430\u0441\u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F
    \u043A\u0430\u043A \u0443\u0434\u043E\u0431\u043D\u044B\u0435 \u0433\u0440\u0430\u0444\u044B
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432
    \u0433\u043E\u0440\u044F\u0447\u0438\u0439 data path, \u043A\u043E\u0433\u0434\u0430
    \u0440\u0430\u0441\u0442\u0443\u0442 \u0441\u0442\u0430\u043A\u0438, \u043F\u0440\u0430\u0432\u0438\u043B\u0430
    \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430 \u0438 \u043C\u0430\u0441\u0441\u043E\u0432\u044B\u0435
    \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438."
  webGlPresetNote: Use 256-2048 for object slots and 1024-8192 for packed slots.
    The packed path is intentionally tuned for heavier stress presets.
  webGlPresetNoteRu: "\u0414\u043B\u044F \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \xAB\u041E\u0431\u044A\u0435\u043A\u0442\u043D\u044B\u0435 \u0441\u043B\u043E\u0442\u044B\xBB
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 256\u20132048,
    \u0434\u043B\u044F \xAB\u0423\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0441\u043B\u043E\u0442\u043E\u0432\xBB \u2014 1024\u20138192. \u0423\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043F\u0443\u0442\u044C \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D \u043F\u043E\u0434 \u0431\u043E\u043B\u0435\u0435
    \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0441\u0442\u0440\u0435\u0441\u0441-\u043F\u0440\u0435\u0441\u0435\u0442\u044B."
  activeItemLabel: visible slots
  activeItemLabelRu: "\u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u0441\u043B\u043E\u0442\u043E\u0432"
