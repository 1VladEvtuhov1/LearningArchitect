  m_Name: Animation3DModule
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.ModuleDefinitionSO
  localizationKey: 
  category: 0
  categoryLabel: Simulation Module
  categoryLabelRu: "\u0421\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C"
  moduleName: 3D Animation
  moduleNameRu: "3D-\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F"
  thesis: Compare procedural crowd animation for humanoid and non-humanoid rigs inside
    the same showcase shell.
  thesisRu: "\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u043D\u043E\u0439
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438 \u0442\u043E\u043B\u043F\u044B
    \u0434\u043B\u044F \u0433\u0443\u043C\u0430\u043D\u043E\u0438\u0434\u043D\u044B\u0445
    \u0438 \u043D\u0435\u0433\u0443\u043C\u0430\u043D\u043E\u0438\u0434\u043D\u044B\u0445
    \u0440\u0438\u0433\u043E\u0432 \u0432\u043D\u0443\u0442\u0440\u0438 \u043E\u0434\u043D\u043E\u0439
    showcase-\u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438."
  description: Interactive 3D animation module demonstrating how rig topology changes
    the runtime animation problem even before authored clips enter the picture.
  descriptionRu: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u043C\u043E\u0434\u0443\u043B\u044C 3D-\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438,
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0449\u0438\u0439, \u043A\u0430\u043A
    \u0442\u043E\u043F\u043E\u043B\u043E\u0433\u0438\u044F \u0440\u0438\u0433\u0430
    \u043C\u0435\u043D\u044F\u0435\u0442 \u0437\u0430\u0434\u0430\u0447\u0443 runtime-\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438
    \u0435\u0449\u0451 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
    \u0432 \u0434\u0435\u043B\u043E \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442
    \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0435 \u043A\u043B\u0438\u043F\u044B."
  problemStatement: Animation architecture is not only about clips or controllers.
    Rig shape, visible count and pose evaluation strategy all change what scales
    cleanly.
  problemStatementRu: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438 \u2014 \u044D\u0442\u043E \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043B\u0438\u043F\u044B \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u044B.
    \u0424\u043E\u0440\u043C\u0430 \u0440\u0438\u0433\u0430, \u0447\u0438\u0441\u043B\u043E
    \u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439
    \u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F
    \u043F\u043E\u0437 \u043C\u0435\u043D\u044F\u044E\u0442 \u0442\u043E, \u0447\u0442\u043E
    \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0447\u0438\u0441\u0442\u043E."
  webGlPresetNote: Use 24-72 for humanoids and 16-64 for creatures in browser-like
    environments. These variants emphasize visible rig complexity over hidden logical
    count.
  webGlPresetNoteRu: "\u0412 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    24\u201372 \u0434\u043B\u044F \u0433\u0443\u043C\u0430\u043D\u043E\u0438\u0434\u043E\u0432
    \u0438 16\u201364 \u0434\u043B\u044F \u0441\u0443\u0449\u0435\u0441\u0442\u0432.
    \u042D\u0442\u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u044E\u0442
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0432\u0438\u0434\u0438\u043C\u043E\u0439
    \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0440\u0438\u0433\u0430,
    \u0430 \u043D\u0435 \u0441\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
  activeItemLabel: animated rigs
  activeItemLabelRu: "\u0430\u043D\u0438\u043C\u0438\u0440\u0443\u0435\u043C\u044B\u0445
    \u0440\u0438\u0433\u043E\u0432"
