  m_TableData:
  - m_Id: 472719360
    m_Localized: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 514662400
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435
      \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0439
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432:
      \u043F\u0440\u043E\u0441\u0442\u0430\u044F \u043E\u0431\u044A\u0435\u043A\u0442\u043D\u0430\u044F
      \u043F\u043E\u0434\u0430\u0447\u0430 \u043F\u0440\u043E\u0442\u0438\u0432 \u043F\u0430\u043A\u0435\u0442\u043D\u043E\u0433\u043E
      \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043C\u0430\u0441\u0441\u0438\u0432\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 523051008
    m_Localized: "\u0427\u0430\u043D\u043A\u043E\u0432\u044B\u0439 \u043F\u0430\u043A\u0435\u0442\u043D\u044B\u0439
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 523051009
    m_Localized: "\u041F\u0430\u043A\u0435\u0442\u043D\u044B\u0439 data-oriented
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442. \u0425\u0440\u0430\u043D\u0438\u0442
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0432 \u043C\u0430\u0441\u0441\u0438\u0432\u0430\u0445 \u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442
      \u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u044B\u043C \u0446\u0438\u043A\u043B\u043E\u043C
      for."
    m_Metadata:
      m_Items: []
  - m_Id: 523051010
    m_Localized: "\u041C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043F\u043E\u0434\u0445\u043E\u0434 \u0441 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u043C
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C \u043D\u0430 \u044D\u0444\u0444\u0435\u043A\u0442,
      \u043D\u043E \u0445\u0443\u0436\u0435 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0438. \u0412\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435
      \u043C\u0430\u0440\u043A\u0435\u0440\u044B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u0442\u044C \u0441\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0445
      \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 523051011
    m_Localized: "\u041E\u0434\u0438\u043D \u043F\u0430\u043A\u0435\u0442\u043D\u044B\u0439
      \u0446\u0438\u043A\u043B \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F\n\n\u0421\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432,
      \u0447\u0435\u043C \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\n\n\u0411\u043E\u043B\u0435\u0435
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u043A data-oriented \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 523051012
    m_Localized: "\u041C\u0435\u043D\u0435\u0435 \u043F\u0440\u044F\u043C\u043E\u043B\u0438\u043D\u0435\u0439\u043D\u044B\u0439
      \u043F\u043E\u0434\u0445\u043E\u0434, \u0447\u0435\u043C \u043E\u0431\u044A\u0435\u043A\u0442
      \u043D\u0430 \u044D\u0444\u0444\u0435\u043A\u0442\n\n\u0422\u0440\u0435\u0431\u0443\u0435\u0442
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438\n\n\u0411\u043E\u043B\u044C\u0448\u0435
      \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0439 \u043B\u043E\u0433\u0438\u043A\u0438,
      \u0447\u0435\u043C \u0443 indie-\u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 523051013
    m_Localized: "\u041E\u0431\u044A\u0435\u043A\u0442\u043D\u044B\u0439 indie-\u0432\u0430\u0440\u0438\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 523051014
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442
      \u043D\u0430 MonoBehaviour. \u0421\u043E\u0437\u0434\u0430\u0435\u0442 \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0438\u0433\u0440\u043E\u0432\u044B\u0445
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432
      \u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442 \u0438\u0445
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0432 \u043E\u0434\u043D\u043E\u043C
      \u0446\u0438\u043A\u043B\u0435 Update."
    m_Metadata:
      m_Items: []
  - m_Id: 523051015
    m_Localized: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 \u043E\u0447\u0435\u043D\u044C
      \u043F\u0440\u043E\u0441\u0442 \u0434\u043B\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F
      \u0438 \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0434\u043B\u044F \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445 indie-\u0434\u0435\u043C\u043E.
      \u041E\u043D \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043C\u043D\u043E\u0433\u043E
      GameObject, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043B\u043E\u0445\u043E
      \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 523051016
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u043B\u0435\u0433\u043A\u043E \u043F\u043E\u043D\u044F\u0442\u044C\n\n\u041F\u0440\u044F\u043C\u0430\u044F
      \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u0447\u0435\u0440\u0435\u0437
      GameObject\n\n\u0425\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0434\u043B\u044F \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u043E\u0432
      \u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0441\u0446\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 523051017
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
      \u0438\u0437\u0434\u0435\u0440\u0436\u043A\u0438\n\n\u041F\u0440\u043E\u0441\u0430\u0434\u043A\u0438
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0437\u0430\u043C\u0435\u0442\u043D\u044B \u043D\u0430 5K/10K\n\n\u0425\u0443\u0436\u0435
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u043A\u0440\u0443\u043F\u043D\u044B\u0445
      \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 314689685626880
    m_Localized: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484480
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435
      \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u043E\u0432
      \u043A \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u044E \u0440\u0435\u0448\u0435\u043D\u0438\u0439
      \u0434\u043B\u044F \u0442\u043E\u043B\u043F \u043F\u0440\u043E\u0441\u0442\u044B\u0445
      \u0430\u0433\u0435\u043D\u0442\u043E\u0432: \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442, utility-\u0418\u0418 \u0438 \u0434\u0435\u0440\u0435\u0432\u043E
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484481
    m_Localized: "\u041F\u0443\u043B \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484482
    m_Localized: "\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043D\u0430\u0438\u0432\u043D\u043E\u0433\u043E
      churn \u0447\u0435\u0440\u0435\u0437 instantiation \u0438 \u044F\u0432\u043D\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
      \u043F\u0443\u043B \u0434\u043B\u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0445\u0441\u044F
      \u044D\u043C\u0438\u0441\u0441\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484483
    m_Localized: "\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0446\u0438\u043A\u043B\u0430
      \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484484
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 runtime-\u0440\u0430\u0437\u043D\u0438\u0446\u0443
      \u043C\u0435\u0436\u0434\u0443 Update \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C
      \u043E\u0431\u044A\u0435\u043A\u0442\u0435 \u0438 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u043C
      \u0446\u0438\u043A\u043B\u043E\u043C \u0443 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873088
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043E \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873089
    m_Localized: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 \u043D\u0430 selector-\u0434\u0435\u0440\u0435\u0432\u0435.
      \u0410\u0433\u0435\u043D\u0442\u044B \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E\u0442 \u0432\u0435\u0442\u0432\u0438
      \u0432\u0440\u043E\u0434\u0435 recover, inspect \u0438 patrol \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442
      \u043F\u0435\u0440\u0432\u0443\u044E \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873090
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u044F
      \u0440\u0435\u0448\u0435\u043D\u0438\u0439 \u0432 \u043C\u043E\u0434\u0443\u043B\u044C\u043D\u043E\u0439
      \u0438 \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0439 \u0444\u043E\u0440\u043C\u0435,
      \u043D\u043E \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0432\u0435\u0442\u0432\u0435\u0439 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u044B\u043C, \u0430 authoring \u0434\u0435\u0440\u0435\u0432\u0430
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873091
    m_Localized: "\u0423\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0435\u043D\u043D\u0430\u044F
      \u0432\u0435\u0442\u0432\u044F\u0449\u0430\u044F\u0441\u044F \u043B\u043E\u0433\u0438\u043A\u0430\n\u041F\u043E\u043D\u044F\u0442\u043D\u0430\u044F
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430 selector / leaf\n\u041B\u0435\u0433\u043A\u043E
      \u043D\u0430\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C \u043E\u0442 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043A \u0431\u043E\u043B\u0435\u0435
      \u0441\u043B\u043E\u0436\u043D\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873092
    m_Localized: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0432\u0435\u0442\u0432\u0435\u0439
      \u0438\u043C\u0435\u0435\u0442 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\n\u0422\u0440\u0435\u0431\u0443\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B
      authoring, \u0447\u0435\u043C FSM\n\u0411\u0435\u0437 \u043E\u0431\u0449\u0438\u0445
      \u0443\u0437\u043B\u043E\u0432 \u0434\u0435\u0440\u0435\u0432\u043E \u0431\u044B\u0441\u0442\u0440\u043E
      \u0448\u0443\u043C\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873093
