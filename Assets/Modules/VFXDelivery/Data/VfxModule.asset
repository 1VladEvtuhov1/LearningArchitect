  m_Script: {fileID: 11500000, guid: ed0f4a08819bca64c9c58234f5a7c14d, type: 3}
  m_Name: VfxModule
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.ModuleDefinitionSO
  localizationKey: vfxmodule
  category: 1
  categoryLabel: Architecture Pattern Module
  categoryLabelRu: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0439
    \u043F\u0430\u0442\u0442\u0435\u0440\u043D"
  moduleName: VFX Delivery
  moduleNameRu: "\u041F\u043E\u0434\u0430\u0447\u0430 VFX"
  thesis: Compare emitter-per-node presentation with a batched pulse layer for dense
    visual feedback.
  thesisRu: "\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u0438
    \u0441 emitter-\u043D\u0430-\u0443\u0437\u0435\u043B \u0438 \u043F\u0430\u043A\u0435\u0442\u043D\u043E\u0433\u043E
    \u0441\u043B\u043E\u044F \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u0432
    \u0434\u043B\u044F \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u0438."
  description: 'Interactive VFX module about presentation architecture: how visible
    feedback is delivered, pooled and bounded when effect density rises.'
  descriptionRu: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    VFX-\u043C\u043E\u0434\u0443\u043B\u044C \u043E \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0435: \u043A\u0430\u043A
    \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u0430\u044F \u043E\u0431\u0440\u0430\u0442\u043D\u0430\u044F
    \u0441\u0432\u044F\u0437\u044C \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F,
    \u043F\u0443\u043B\u0438\u0442\u0441\u044F \u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438 \u0440\u043E\u0441\u0442\u0435 \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u0438
    \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432."
  problemStatement: VFX systems often fail not because the feedback is conceptually
    wrong, but because ownership and rendering strategy do not match the expected
    density.
  problemStatementRu: "VFX-\u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0447\u0430\u0441\u0442\u043E
    \u043B\u043E\u043C\u0430\u044E\u0442\u0441\u044F \u043D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443,
    \u0447\u0442\u043E \u0441\u0430\u043C\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u0430\u044F
    \u0441\u0432\u044F\u0437\u044C \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043D\u0430
    \u043D\u0435\u0432\u0435\u0440\u043D\u043E, \u0430 \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u0435 \u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F
    \u0440\u0435\u043D\u0434\u0435\u0440\u0430 \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442
    \u0441 \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u043E\u0439 \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C\u044E."
  webGlPresetNote: Use 24-120 for emitter bursts and 800-4800 for batched pulses.
    The two variants intentionally represent different ownership models.
  webGlPresetNoteRu: "\u0414\u043B\u044F \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \xAB\u042D\u043C\u0438\u0442\u0442\u0435\u0440\u043D\u044B\u0435 \u0432\u0441\u043F\u043B\u0435\u0441\u043A\u0438\xBB
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 24\u2013120,
    \u0434\u043B\u044F \xAB\u041F\u0430\u043A\u0435\u0442\u043D\u044B\u0445 \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u0432\xBB
    \u2014 800\u20134800. \u042D\u0442\u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
    \u0440\u0430\u0437\u043D\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438 \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F."
  activeItemLabel: visible emitters
  activeItemLabelRu: "\u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u044D\u043C\u0438\u0442\u0442\u0435\u0440\u043E\u0432"
