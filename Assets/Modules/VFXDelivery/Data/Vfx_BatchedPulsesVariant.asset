  variantName: Batched Pulses
  variantNameRu: "\u041F\u0430\u043A\u0435\u0442\u043D\u044B\u0435 \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u044B"
  prefab: {fileID: 5216840241422276828, guid: 29392bc023bffb5489a449b2d2b8d412, type: 3}
