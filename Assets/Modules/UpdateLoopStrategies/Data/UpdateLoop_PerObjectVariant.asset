  variantName: Per-Object Update Variant
  variantNameRu: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 \u0441 Update \u043D\u0430
    \u043A\u0430\u0436\u0434\u043E\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0435"
  prefab: {fileID: 3854783096635441085, guid: a78d6f1ac649bc84a98a6d5655ee2b49, type: 3}
