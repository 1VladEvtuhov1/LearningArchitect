  localizationKey: 
  variantName: Instantiation / Destroy Variant
  variantNameRu: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 Instantiate / Destroy"
  prefab: {fileID: 624674788007679013, guid: f6b719e1277e24340b1d89232994a114, type: 3}
