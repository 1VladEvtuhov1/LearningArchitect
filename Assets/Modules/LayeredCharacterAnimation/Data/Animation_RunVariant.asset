  variantName: Run
  variantNameRu: "\u0411\u0435\u0433"
  prefab: {fileID: 5816978165570920196, guid: 196ea95fc68bf2e479d4459d2bf3791d, type: 3}
  stressPresets: 010000000400000008000000
