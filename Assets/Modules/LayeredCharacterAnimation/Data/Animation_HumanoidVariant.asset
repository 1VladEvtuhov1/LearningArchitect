  variantName: Humanoid Crowd
  variantNameRu: "\u0413\u0443\u043C\u0430\u043D\u043E\u0438\u0434\u043D\u0430\u044F
    \u0442\u043E\u043B\u043F\u0430"
  prefab: {fileID: 1114136981102670249, guid: cc6e66461170d1448a87bd220a694895, type: 3}
  stressPresets: 180000003000000048000000
