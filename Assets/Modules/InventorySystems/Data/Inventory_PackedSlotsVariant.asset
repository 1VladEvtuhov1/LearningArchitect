  variantName: Packed Slots
  variantNameRu: "\u0423\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0441\u043B\u043E\u0442\u044B"
  prefab: {fileID: 656233261501566291, guid: 222c4855de7928d4db1cfbec59578567, type: 3}
