  m_Name: Inventory_ObjectSlotsVariant
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.VariantDefinitionSO
  localizationKey: 
  variantName: Object Slots
  variantNameRu: "\u041E\u0431\u044A\u0435\u043A\u0442\u043D\u044B\u0435 \u0441\u043B\u043E\u0442\u044B"
  prefab: {fileID: 7778248642727801718, guid: a3ae88be0b3607543b41a801253b80be, type: 3}
  stressPresets: 000100000004000000080000
