  localizationKey: 
  variantName: FSM Decision Variant
  variantNameRu: "\u041A\u043E\u043D\u0435\u0447\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442"
  prefab: {fileID: 1718115676741377603, guid: 2a0cf882a111d1e458d859422b3bacc2, type: 3}
  stressPresets: f4010000d007000088130000
  stressPresetLabels:
