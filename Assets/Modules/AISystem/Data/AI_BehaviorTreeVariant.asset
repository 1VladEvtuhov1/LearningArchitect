  localizationKey: 
  variantName: Behavior Tree Variant
  variantNameRu: "\u0414\u0435\u0440\u0435\u0432\u043E \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F"
  prefab: {fileID: 842003395431596775, guid: c554cc516a0ea0a48855af07bf8ba0d3, type: 3}
