  m_Script: {fileID: 11500000, guid: ed0f4a08819bca64c9c58234f5a7c14d, type: 3}
  m_Name: EffectsModule
  m_EditorClassIdentifier: Assembly-CSharp::LearningArchitect.Core.ModuleDefinitionSO
  localizationKey: effectsmodule
  category: 0
  moduleName: Effects System
  thesis: Compare a readable object-centric effect loop with a batched data-oriented
    simulation path.
  thesisRu: "\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0433\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u043D\u043E\u0433\u043E \u0446\u0438\u043A\u043B\u0430 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432 \u0441 \u043F\u0430\u043A\u0435\u0442\u043D\u044B\u043C data-oriented \u043F\u0443\u0442\u0435\u043C \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438."
  moduleNameRu: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432"
  description: 'Interactive comparison of effect-system implementations: simple object-based
    presentation versus batched array update.'
  descriptionRu: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432: \u043F\u0440\u043E\u0441\u0442\u0430\u044F \u043E\u0431\u044A\u0435\u043A\u0442\u043D\u0430\u044F \u043F\u043E\u0434\u0430\u0447\u0430 \u043F\u0440\u043E\u0442\u0438\u0432 \u043F\u0430\u043A\u0435\u0442\u043D\u043E\u0433\u043E \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043C\u0430\u0441\u0441\u0438\u0432\u043E\u0432."
  problemStatement: Effect-heavy scenes often start with direct GameObject logic
    and then hit hierarchy, update, and visualization cost. This module shows when
    simulation state should be separated from the rendered subset.
  problemStatementRu: "\u041D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0430\u043C\u0438 \u0441\u0446\u0435\u043D\u044B \u0447\u0430\u0441\u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0441 \u043F\u0440\u044F\u043C\u043E\u0439 \u043B\u043E\u0433\u0438\u043A\u0438 \u043D\u0430 GameObject, \u0430 \u0437\u0430\u0442\u0435\u043C \u0443\u043F\u0438\u0440\u0430\u044E\u0442\u0441\u044F \u0432 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0438, \u0430\u043F\u0434\u0435\u0439\u0442\u0430 \u0438 \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438. \u042D\u0442\u043E\u0442 \u043C\u043E\u0434\u0443\u043B\u044C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438 \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u0435\u043B\u044F\u0442\u044C \u043E\u0442 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0433\u043E \u043F\u043E\u0434\u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0430."
  webGlPresetNote: Use 25 to 2500 in browser for stable viewing. 10000 is a stress
    demonstration and depends heavily on browser and machine. In the chunked variant,
    stress load shows simulated effects while visible effects shows the marker subset
    on scene.
  webGlPresetNoteRu: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 25-2500 \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435 \u0434\u043B\u044F \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430. 10000 \u044D\u0442\u043E \u0441\u0442\u0440\u0435\u0441\u0441\u043E\u0432\u044B\u0439 \u0440\u0435\u0436\u0438\u043C \u0438 \u043E\u043D \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430 \u0438 \u043C\u0430\u0448\u0438\u043D\u044B. \u0412 \u0447\u0430\u043D\u043A\u043E\u0432\u043E\u043C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0435 stress load \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0447\u0438\u0441\u043B\u043E \u0441\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432, \u0430 visible effects - \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043C\u0430\u0440\u043A\u0435\u0440\u043E\u0432 \u043D\u0430 \u0441\u0446\u0435\u043D\u0435."
  activeItemLabel: visible effects
  activeItemLabelRu: "\u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432"
