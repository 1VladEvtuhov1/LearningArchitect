%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ShowcaseContent_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 64a7ca1e30d66dc4388fde2ccddb524e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 472719360
    m_Localized: Effects System
    m_Metadata:
      m_Items: []
  - m_Id: 514662400
    m_Localized: 'Interactive comparison of effect-system implementations: simple
      object-based presentation versus batched array update.'
    m_Metadata:
      m_Items: []
  - m_Id: 523051008
    m_Localized: Chunk Batched Variant
    m_Metadata:
      m_Items: []
  - m_Id: 523051009
    m_Localized: Batched data-oriented variant. Stores positions and velocities in
      arrays and updates them with a simple for loop.
    m_Metadata:
      m_Items: []
  - m_Id: 523051010
    m_Localized: Much better scaling than per-object behaviour, but less direct to
      inspect in the hierarchy. Visual markers show only a subset of simulated effects,
      so the on-scene count stays lower than the simulated load.
    m_Metadata:
      m_Items: []
  - m_Id: 523051011
    m_Localized: 'One batched update loop

      Simulates more effects than it renders

      Clearer
      path toward data-oriented optimization'
    m_Metadata:
      m_Items: []
  - m_Id: 523051012
    m_Localized: 'Less direct than object-per-effect

      Needs custom visualization

      More
      bookkeeping than the indie variant'
    m_Metadata:
      m_Items: []
  - m_Id: 523051013
    m_Localized: Indie Object Variant
    m_Metadata:
      m_Items: []
  - m_Id: 523051014
    m_Localized: Simple MonoBehaviour variant. Spawns a readable number of effect
      GameObjects and updates them explicitly in one Update loop.
    m_Metadata:
      m_Items: []
  - m_Id: 523051015
    m_Localized: Very easy to understand and useful for small indie demos. It creates
      many GameObjects, so it is not a high-scale runtime architecture.
    m_Metadata:
      m_Items: []
  - m_Id: 523051016
    m_Localized: 'Very easy to understand

      Direct GameObject visualization

      Good
      for prototypes and small scenes'
    m_Metadata:
      m_Items: []
  - m_Id: 523051017
    m_Localized: 'High object count creates overhead

      Performance drops are
      visible at 5K/10K

      Less suitable for large simulations'
    m_Metadata:
      m_Items: []
  - m_Id: 314689685626880
    m_Localized: AI System
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484480
    m_Localized: 'Interactive comparison of decision-making approaches for crowds
      of simple agents: FSM, Utility AI and Behavior Tree.'
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484481
    m_Localized: Object Pooling
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484482
    m_Localized: Comparison between naive instantiation churn and explicit pooled
      reuse for repeated visual emissions.
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484483
    m_Localized: Update Loop Strategies
    m_Metadata:
      m_Items: []
  - m_Id: 314689790484484
    m_Localized: Shows the runtime difference between per-object MonoBehaviour updates
      and a centralized owner loop.
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873088
    m_Localized: Behavior Tree Variant
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873089
    m_Localized: Selector-driven variant. Agents evaluate ordered branches such as
      recover, inspect and patrol, then execute the first valid branch.
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873090
    m_Localized: Keeps decision rules modular and readable in branch form, but evaluation
      order becomes important and tree authoring needs discipline.
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873091
    m_Localized: 'Ordered branch logic

      Readable selector / leaf structure

      Easy
      to grow from simple to richer behavior'
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873092
    m_Localized: 'Branch order matters

      More authoring discipline than FSM

      Can
      grow noisy without shared nodes'
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873093
    m_Localized: FSM Decision Variant
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873094
    m_Localized: Finite-state variant. Every agent tracks a tiny explicit state and
      transitions between idle and move phases.
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873095
    m_Localized: Very easy to debug and reason about, but branch-heavy and harder
      to extend when the number of states grows.
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873096
    m_Localized: 'Explicit states

      Simple transition graph

      Predictable
      debugging flow'
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873097
    m_Localized: 'More branching per agent

      State explosion risk

      Less
      flexible prioritization'
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873098
    m_Localized: Utility Scoring Variant
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873099
    m_Localized: Utility-driven variant. Agents periodically score candidate goals
      and bias movement toward the best option.
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873100
    m_Localized: More adaptive than a tiny FSM, but behaviour is less obvious from
      a single agent snapshot and tuning scores matters.
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873101
    m_Localized: 'Adaptive prioritization

      Smoother behavior blending

      Good
      base for richer heuristics'
    m_Metadata:
      m_Items: []
  - m_Id: 314689798873102
    m_Localized: 'Harder to inspect at a glance

      Needs score tuning

      Less
      explicit than FSM'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067392
    m_Localized: Instantiation / Destroy Variant
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067393
    m_Localized: Naive lifecycle variant. Visual markers are created and destroyed
      continuously as the simulation churns.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067394
    m_Localized: Simple to author, but creates allocation churn, transform churn
      and more work for the engine as load rises.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067395
    m_Localized: 'Minimal authoring complexity

      Easy to understand lifecycle

      Shows
      raw engine cost clearly'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067396
    m_Localized: 'Continuous allocations

      Destroy/instantiate overhead

      Poor
      stress scaling'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067397
    m_Localized: Reusable Pool Variant
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067398
    m_Localized: Pool-backed variant. A fixed set of markers is created once and
      then recycled for subsequent emissions.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067399
    m_Localized: Better runtime stability and much less churn, but it needs pool
      warmup and stricter bookkeeping of active slots.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067400
    m_Localized: 'Stable allocations

      Cheaper reuse path

      Better sustained
      load behavior'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067401
    m_Localized: 'Needs prewarm capacity

      More bookkeeping

      Idle memory
      footprint'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067402
    m_Localized: Centralized Update Variant
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067403
    m_Localized: Central loop variant. Positions and velocities are updated in one
      owner loop while only a subset is rendered.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067404
    m_Localized: Scales better and keeps orchestration in one place, but loses the
      object-local mental model and needs custom data handling.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067405
    m_Localized: 'One update owner

      Cleaner scaling path

      Lower callback
      overhead'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067406
    m_Localized: 'Less object-local logic

      Needs custom data layout

      Harder
      to inspect per item'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067407
    m_Localized: Per-Object Update Variant
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067408
    m_Localized: Object-centric variant. Every visible mover owns its own MonoBehaviour
      Update loop and local motion state.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067409
    m_Localized: Very approachable for small counts, but callback overhead and hierarchy
      noise grow quickly with the number of objects.
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067410
    m_Localized: 'Straightforward authoring

      Local behavior per object

      Great
      for tiny scenes'
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067411
    m_Localized: 'Many Update callbacks

      Hierarchy noise

      Weak scaling
      for large swarms'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819196596224
    m_Localized: Layered Character Animation
    m_Metadata:
      m_Items: []
  - m_Id: 1473819288870912
    m_Localized: 'Interactive character-animation module focused on a common game-dev
      mechanic: keeping locomotion active while a combat action plays on the upper
      body.'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819288870913
    m_Localized: Inventory Systems
    m_Metadata:
      m_Items: []
  - m_Id: 1473819288870914
    m_Localized: Interactive inventory module focused on state mutation patterns,
      stack movement and the cost of per-slot ownership.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819288870915
    m_Localized: VFX Delivery
    m_Metadata:
      m_Items: []
  - m_Id: 1473819288870916
    m_Localized: 'Interactive VFX module about presentation architecture: how visible
      feedback is delivered, pooled and bounded when effect density rises.'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842432
    m_Localized: Creature Crowd
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842433
    m_Localized: The creature rig is non-humanoid and topology-specific. Motion is
      driven by body sway, tail follow-through and quadruped gait timing instead
      of biped assumptions.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842434
    m_Localized: Shared animation tooling becomes less universal because each creature
      family pushes different rig rules.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842435
    m_Localized: 'Flexible topology-specific motion

      Good fit for procedural
      creatures

      Distinct visual identity'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842436
    m_Localized: 'Lower rig reuse across creature families

      More bespoke motion
      rules

      Comparisons against humanoid intuition are weaker'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842437
    m_Localized: Humanoid Crowd
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842438
    m_Localized: 'A small humanoid rig is sampled procedurally from shared motion
      data. The emphasis is on a recognizable biped pose stack: torso, head, arms
      and legs.'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842439
    m_Localized: Humanoid rigs ask for clearer joint intent and usually more authored
      pose discipline.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842440
    m_Localized: 'Readable motion language

      Clear silhouette changes

      Good
      baseline for character-facing features'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842441
    m_Localized: 'More semantic joints to maintain

      Higher expectation of believable
      posing

      Scales visible rig complexity faster'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842442
    m_Localized: Object Slots
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842443
    m_Localized: Each slot is represented as a dedicated object state. Transfers
      are easy to reason about because ownership, type and stack size stay attached
      to the slot instance.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842444
    m_Localized: Mutation walks object references and each slot carries its own lifecycle
      state.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842445
    m_Localized: 'Readable ownership model

      Easy to extend with slot-specific
      rules

      Direct debugging at the slot level'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842446
    m_Localized: 'Higher per-slot overhead

      More object state to traverse

      Harder
      to batch under heavier counts'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842447
    m_Localized: Packed Slots
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842448
    m_Localized: Slot data is stored in tightly packed arrays. Transfer rules are
      applied by index so the hot loop stays centralized and cache-friendly.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842449
    m_Localized: Rules must be expressed through indices and explicit arrays instead
      of rich per-slot objects.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842450
    m_Localized: 'Stable centralized update path

      Better scaling headroom

      Cheaper
      iteration over large slot sets'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819309842451
    m_Localized: 'Less expressive per-slot modeling

      More bookkeeping around
      indices

      Feature work needs stronger discipline'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036736
    m_Localized: Batched Pulses
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036737
    m_Localized: Logical pulses are updated in arrays and only a bounded visible
      subset is rendered. The visual layer stays pooled even when the logical effect
      stream becomes large.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036738
    m_Localized: The link between logical events and visible markers is less literal,
      so content tuning becomes more systems-oriented.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036739
    m_Localized: 'Cheap visible layer under heavy logical load

      Clear separation
      between simulation and presentation

      Predictable pooling behavior'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036740
    m_Localized: 'Less one-to-one authoring feel

      Needs deliberate mapping
      from events to visuals

      Debugging is more systems-focused than scene-focused'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036741
    m_Localized: Emitter Bursts
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036742
    m_Localized: Each visible node owns its own particle emitter. Authoring is straightforward
      because the visual behavior lives next to the emitter transform.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036743
    m_Localized: Per-node ownership increases scene-side component count and makes
      high emitter density more expensive.
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036744
    m_Localized: 'Local authoring is intuitive

      Emitter state stays easy to
      inspect

      Strong fit for sparse hero moments'
    m_Metadata:
      m_Items: []
  - m_Id: 1473819314036745
    m_Localized: 'Scene component count rises quickly

      Dense emitter fields
      get expensive

      Harder to compress into a shared render path'
    m_Metadata:
      m_Items: []
  - m_Id: 1474110327431168
    m_Localized: Compare decision models over the same shared world state.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208384
    m_Localized: AI crowds need more than believable behavior. The decision model
      also has to stay inspectable, predictable, and maintainable as agent count
      grows.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208385
    m_Localized: Use 500-2000 agents in browser and 5K on desktop. Presets scale
      full decision simulation while visible agents stay curated for readability.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208386
    m_Localized: visible agents
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208387
    m_Localized: Show how one humanoid model can run, shoot, or combine both through
      Animator layers and an upper-body AvatarMask.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208388
    m_Localized: Full-body clips are easy to preview, but action games need composition.
      The interesting architecture is separating locomotion ownership from upper-body
      actions.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208389
    m_Localized: Use Solo/Squad/Crowd presets for browser-safe previews. The goal
      is readability of layer mixing, not pushing thousands of skinned meshes.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208390
    m_Localized: animated actors
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208391
    m_Localized: Compare a readable object-centric effect loop with a batched data-oriented
      simulation path.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208392
    m_Localized: Effect-heavy scenes often start with direct GameObject logic and
      then hit hierarchy, update, and visualization cost. This module shows when
      simulation state should be separated from the rendered subset.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208393
    m_Localized: Use 25 to 2500 in browser for stable viewing. 10000 is a stress
      demonstration and depends heavily on browser and machine. In the chunked variant,
      stress load shows simulated effects while visible effects shows the marker
      subset on scene.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110344208394
    m_Localized: visible effects
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402688
    m_Localized: Compare object-rich slot ownership with packed slot processing under
      sustained transfer load.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402689
    m_Localized: Inventory features often start as convenient object graphs and later
      become a hot data path once stacking, transfer rules and bulk operations grow.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402690
    m_Localized: Use 256-2048 for object slots and 1024-8192 for packed slots. The
      packed path is intentionally tuned for heavier stress presets.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402691
    m_Localized: visible slots
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402692
    m_Localized: Show how the same visual outcome changes when object lifetime is
      reused instead of churned.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402693
    m_Localized: Repeated spawn and despawn loops create allocation and lifecycle
      cost that often stays hidden until load spikes. This module isolates object
      reuse as a first-class production pattern.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402694
    m_Localized: Use 500 or 2000 in browser. Higher presets are meant to expose churn
      differences and may not stay smooth on every machine.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402695
    m_Localized: visible projectiles
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402696
    m_Localized: Show why ownership of update work matters before reaching ECS-level
      complexity.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402697
    m_Localized: Many Unity systems begin with one MonoBehaviour per object because
      it is easy to read. This module shows when callback count and hierarchy noise
      make a centralized owner loop the better baseline.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402698
    m_Localized: Use lower presets for the per-object variant in browser. The centralized
      variant is the more browser-safe comparison path.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402699
    m_Localized: visible movers
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402700
    m_Localized: Compare emitter-per-node presentation with a batched pulse layer
      for dense visual feedback.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402701
    m_Localized: VFX systems often fail not because the feedback is conceptually
      wrong, but because ownership and rendering strategy do not match the expected
      density.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402702
    m_Localized: Use 24-120 for emitter bursts and 800-4800 for batched pulses. The
      two variants intentionally represent different ownership models.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110348402703
    m_Localized: visible emitters
    m_Metadata:
      m_Items: []
  - m_Id: 1474110360985600
    m_Localized: Evaluates ordered branches such as recover, inspect, and patrol.
      Compared with FSM, behavior composition is more modular; compared with Utility
      AI, priority is explicit rather than score-driven.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179904
    m_Localized: Behavior Trees scale well in authoring clarity when branch discipline
      is strong.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179905
    m_Localized: Uses explicit per-agent states and direct transitions. Relative
      to Utility AI and Behavior Trees, this is the easiest variant to trace step
      by step.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179906
    m_Localized: FSM is the clearest baseline when state space is small and predictable.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179907
    m_Localized: Scores candidate actions and moves toward the best option. Compared
      with FSM, behavior is more adaptive; compared with Behavior Trees, tuning shifts
      from branch order to score design.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179908
    m_Localized: Utility AI is strong when adaptation matters more than explicit
      step-by-step readability.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179909
    m_Localized: Non-humanoid animation shifts the problem from human readability
      to topology control, where every rig family wants its own locomotion rules.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179910
    m_Localized: Strong option when the project benefits from bespoke silhouettes
      and procedural motion can stay aligned with a specific body plan.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179911
    m_Localized: Humanoid motion is easier to read because viewers immediately understand
      the pose, but the rig carries more semantic joints and balancing expectations.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179912
    m_Localized: Best fit when readability, body language and familiar silhouettes
      are part of the feature value.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110365179913
    m_Localized: Stores simulation state in arrays and renders only a representative
      subset. Compared with the indie variant, it favors scalable simulation over
      object-level visibility. The selected stress load can be much higher than the
      number of cubes shown on scene.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374208
    m_Localized: In this variant, stress load and visible scene count are intentionally
      different. Simulation scales independently from presentation.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374209
    m_Localized: Creates a readable set of effect GameObjects and updates them directly.
      Compared with the chunked variant, simulation and presentation stay tightly
      coupled.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374210
    m_Localized: Best for small, legible showcases; weak as a path to large-scale
      effect simulation.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374211
    m_Localized: The object-centric version favors readability and direct mutation,
      but pays more per-slot overhead when the inventory graph gets larger.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374212
    m_Localized: Good baseline when rules change often and debugging individual slot
      behavior matters more than raw throughput.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374213
    m_Localized: The packed version trades some ergonomics for a much more predictable
      mutation path when many slots update every frame.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374214
    m_Localized: Useful once inventory traffic becomes systemic and the project needs
      deterministic high-volume processing more than per-slot convenience.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374215
    m_Localized: Continuously creates and destroys visual markers. Compared with
      the pooled variant, the visible result is similar, but lifecycle cost is much
      higher.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374216
    m_Localized: Instantiate/Destroy is acceptable for low churn, but it becomes
      the bottleneck once repetition is part of the feature.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374217
    m_Localized: Warms a reusable set of markers and recycles slots on demand. Compared
      with instantiation churn, it shifts cost upfront and stabilizes the steady-state
      loop.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374218
    m_Localized: Pooling is a production pattern for repeatable emissions, not just
      a micro-optimization.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374219
    m_Localized: One owner updates shared arrays of positions and velocities. Compared
      with per-object Update, it reduces callback overhead and makes future data-oriented
      refactors easier.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374220
    m_Localized: Centralizing update ownership is often the first meaningful step
      toward scalable Unity runtime code.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374221
    m_Localized: Each mover owns its own MonoBehaviour Update and local state. Compared
      with centralized update, the mental model is friendlier but scales poorly in
      callback count.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374222
    m_Localized: Per-object Update is a good teaching baseline and a weak long-term
      scaling path.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374223
    m_Localized: The batched path favors scale by separating logical pulses from
      the rendered subset instead of letting every effect source own a full emitter
      stack.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374224
    m_Localized: Appropriate for dense feedback fields where the project needs visual
      rhythm without one renderer or emitter per event.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374225
    m_Localized: Emitter-per-node VFX is easy to author and inspect, but the visible
      graph grows quickly as more burst sources are added.
    m_Metadata:
      m_Items: []
  - m_Id: 1474110369374226
    m_Localized: Useful for hero interactions, sparse emitters and content that benefits
      from local ownership of its visual feedback.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328118816768
    m_Localized: Each agent evaluates ordered behavior branches through a shared
      tree model, then applies the first branch that succeeds.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328206897152
    m_Localized: Stress presets seed agent count, each frame runs branch evaluation
      plus movement integration, and teardown clears the shared simulation host.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328206897153
    m_Localized: Chosen when behaviors need authorable structure and ordered fallbacks
      without exploding into a large manual transition table.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091456
    m_Localized: Each agent stores an explicit state enum, the decision model evaluates
      transitions, and the presenter reflects the chosen movement target.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091457
    m_Localized: Stress presets create more agents, each frame advances sensing and
      state transitions, and cleanup disposes the shared simulation host.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091458
    m_Localized: Best baseline when behavior should be debuggable step by step and
      the state space stays small enough to remain explicit.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091459
    m_Localized: Each agent scores candidate actions, selects the highest utility
      option, and the host converts that choice into movement and recovery behavior.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091460
    m_Localized: Stress presets seed agent count, every frame recalculates action
      scores, and the host-owned simulation state is recycled on unload.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091461
    m_Localized: Chosen when adaptation matters more than explicit scriptability
      and behavior should respond continuously to changing context.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091462
    m_Localized: Effect state lives in arrays, one batched update loop advances logical
      particles, and only a representative visual slice is rendered.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091463
    m_Localized: Stress presets resize logical chunks, the batch update advances
      all entries each frame, and the visible proxy set is recycled.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091464
    m_Localized: Chosen when logical density matters more than one-to-one scene objects
      and the project needs predictable scaling under load.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091465
    m_Localized: Each visible effect owns its own lifetime, position, and visual
      response, then writes motion directly to its GameObject.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091466
    m_Localized: Stress presets spawn a readable set of effect actors, each actor
      updates itself every frame, and cleanup happens per object.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091467
    m_Localized: Kept as the simple path because it mirrors how small teams prototype
      effect behavior before they need scale-oriented orchestration.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091468
    m_Localized: Each slot object owns item references and counts, and transfer rules
      mutate those slot instances directly.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091469
    m_Localized: Stress presets create more slots, the variant runs transfer passes
      over slot objects, and the object graph stays alive for the session.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091470
    m_Localized: Good when rules are still evolving and engineers need to inspect
      ownership and mutations at the slot level.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091471
    m_Localized: Item ids, counts, and metadata stay in packed arrays, and transfer
      rules operate by index over centralized storage.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091472
    m_Localized: Stress presets expand packed buffers, one update path processes
      transfer work, and the view only reflects resulting state.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328211091473
    m_Localized: Chosen when inventory traffic becomes systemic and the team needs
      cache-friendly, centralized updates.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328215285760
    m_Localized: Shared simulation state drives topology-specific actors, and each
      creature rig translates that state into bespoke procedural pose changes.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328215285761
    m_Localized: Stress presets size the creature set, Update advances motion parameters,
      and creature visuals stay bound to the variant until teardown.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328215285762
    m_Localized: Chosen when silhouette variety and non-humanoid motion are more
      important than universal rig reuse.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328219480064
    m_Localized: Shared crowd state drives per-actor parameters, humanoid rigs sample
      the same animation logic, and each actor writes results to its Animator.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328219480065
    m_Localized: Stress presets size the crowd, Update advances shared phase and
      actor parameters, and visuals stay active for the variant lifetime.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674368
    m_Localized: Chosen when readability and avatar reuse matter, because humanoid
      rigs communicate motion intent with familiar body language.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674369
    m_Localized: Base locomotion stays on the lower body while an upper-body layer
      injects the firing pose through masking and synchronized parameters.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674370
    m_Localized: Activation loads the layered controller, Update maintains locomotion
      plus combat parameters, and shutdown removes the combined rig.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674372
    m_Localized: A single locomotion parameter path drives the base Animator state,
      and the pose is authored as one clean full-body clip.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674373
    m_Localized: Variant activation loads the controller and avatar, Update only
      maintains simple locomotion state, and shutdown releases the rig.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674374
    m_Localized: Useful as the simplest baseline for validating retargeted movement
      before layering extra mechanics.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674375
    m_Localized: The Animator stays on an authored firing state, and the variant
      feeds only the parameters needed to hold the combat pose.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674376
    m_Localized: Activation binds the combat controller, the pose loops with minimal
      runtime logic, and teardown unloads the presentation rig.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674377
    m_Localized: Useful as a reference pose because it isolates weapon handling and
      upper-body readability without locomotion complexity.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674378
    m_Localized: The spawner decides target churn, creates markers on demand, lets
      them expire, and destroys them when their lifetime ends.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674379
    m_Localized: Each frame checks target load, spawns fresh objects, updates active
      markers, and releases memory only through destroy.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674380
    m_Localized: Kept as the control case because it exposes the real cost of naive
      allocation-heavy lifecycles.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674381
    m_Localized: Emission requests claim slots from a prewarmed pool, active markers
      update in place, and completed markers return to free slots.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674382
    m_Localized: Startup prewarms reusable objects, stress load adjusts logical demand,
      each frame reuses active slots, and deactivate returns the pool to idle.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674383
    m_Localized: Chosen for repeatable emissions because it moves cost to setup and
      stabilizes the steady-state frame loop.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674384
    m_Localized: One manager updates shared position and velocity arrays, then pushes
      the resulting transforms into a bounded visual layer.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674385
    m_Localized: Stress presets resize simulation buffers, one Update advances all
      entries, and visuals are reused until variant shutdown.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674386
    m_Localized: Chosen when coordination and scaling matter more than per-object
      scripting convenience.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674387
    m_Localized: Each mover reads its local fields in its own Update, integrates
      motion, and writes directly to its Transform.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674388
    m_Localized: Stress presets instantiate mover GameObjects, each object runs independently
      every frame, and teardown destroys the whole set.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674389
    m_Localized: Useful as a baseline because ownership stays local and every behavior
      is easy to trace in the hierarchy.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674390
    m_Localized: Logical pulse events live in arrays, one controller advances them,
      and a limited marker set visualizes only the currently relevant pulses.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674391
    m_Localized: Stress presets expand logical pulse count, one batched Update advances
      the field, and visual markers are reused across pulses.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674392
    m_Localized: Chosen when feedback density is high and the project needs far more
      logical events than visible scene objects.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674393
    m_Localized: Each node owns a particle emitter, local timers decide when to burst,
      and the particle system handles the visual playback.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674394
    m_Localized: Stress presets enable more emitter nodes, Update triggers local
      burst logic, and emitters stay resident until variant shutdown.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674395
    m_Localized: Useful when artists need local authoring and clear scene-side ownership
      for each feedback source.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049478832128
    m_Localized: Run + Shoot
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718208
    m_Localized: The base layer keeps the running clip on the legs while an AvatarMask
      routes the shooting clip to body, head, arms and fingers on a second Animator
      layer.
    m_Metadata:
      m_Items: []
  - m_Id: 2245328223674371
    m_Localized: 'Chosen because it demonstrates the real value of layered animation:
      concurrent mechanics without duplicating full-body clips.'
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718209
    m_Localized: 'This is the production-style case: locomotion and combat are composed
      instead of replacing each other.'
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718210
    m_Localized: Best demonstration of why Animator layers and masks matter for game
      animation systems.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718211
    m_Localized: More setup and masking discipline, but the mechanic remains responsive
      while moving.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718212
    m_Localized: 'Movement and shooting coexist

      Upper-body mask keeps legs
      running

      Closer to real action-game animation graphs'
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718213
    m_Localized: 'Needs clean humanoid avatar

      Mask boundaries must be tuned

      Layered
      clips can expose pose conflicts'
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718214
    m_Localized: Run
    m_Metadata:
      m_Items: []
  - m_Id: 2257049562718215
    m_Localized: The same Paladin model plays a humanoid locomotion clip through
      a reusable AnimatorController. Movement drives Speed and Turn parameters, while
      the upper-body shooting layer stays disabled.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912512
    m_Localized: Clean baseline for checking retargeted locomotion, root locking
      and readable movement direction.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912513
    m_Localized: Best when the character only needs full-body movement and simple
      parameter driving.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912514
    m_Localized: Readable and cheap, but it does not cover concurrent combat actions.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912515
    m_Localized: 'Simple controller path

      Clear locomotion baseline

      Good
      for validating imported clips'
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912516
    m_Localized: 'No concurrent action layer

      Combat interrupts movement

      Less
      representative for action games'
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912517
    m_Localized: Shoot
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912518
    m_Localized: The model stays in place and plays the shooting clip as the base
      full-body state. This isolates aiming and weapon pose readability before mixing
      is enabled.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912519
    m_Localized: Useful for checking the authored combat pose, but movement and shooting
      still compete for the same body.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912520
    m_Localized: Best as an authored combat reference state, not as the final runtime
      solution.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912521
    m_Localized: Strong pose clarity, weak locomotion composition.
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912522
    m_Localized: 'Clear weapon pose

      Easy to debug clip import

      Stable
      stationary preview'
    m_Metadata:
      m_Items: []
  - m_Id: 2257049566912523
    m_Localized: 'Cannot move while firing

      Full-body clip owns the legs

      Not
      enough for shooter locomotion'
    m_Metadata:
      m_Items: []
  - m_Id: 5020180168908800
    m_Localized: 'Readable baseline: one Update per mover.'
    m_Metadata:
      m_Items: []
  - m_Id: 5020180248600576
    m_Localized: One owner loop replaces callback pressure.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180248600577
    m_Localized: Spawn churn appears immediately under repeated load.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794880
    m_Localized: Reuse stabilizes the steady-state runtime path.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794881
    m_Localized: Object-level logic is easy to read at small counts.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794882
    m_Localized: Decoupling simulation from visuals unlocks scale.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794883
    m_Localized: Explicit state is easiest to debug and explain.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794884
    m_Localized: Scoring trades traceability for adaptation.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794885
    m_Localized: Branch structure keeps intent readable.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794886
    m_Localized: Object-rich slots are readable but spend more work on ownership
      and mutation paths.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794887
    m_Localized: Packed arrays keep the transfer loop tight under heavier load.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794888
    m_Localized: Baseline locomotion keeps the character readable before combat is
      layered in.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794889
    m_Localized: Animator layers keep shooting responsive while locomotion continues
      underneath.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794890
    m_Localized: One emitter per node is straightforward but scales visible authoring
      cost quickly.
    m_Metadata:
      m_Items: []
  - m_Id: 5020180252794891
    m_Localized: Shared pulse rendering keeps the visible layer cheaper than emitter-per-event
      playback.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
