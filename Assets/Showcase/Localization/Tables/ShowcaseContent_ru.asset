  - m_Id: 314689803067392
    m_Localized: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 Instantiate / Destroy"
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067393
    m_Localized: "\u041D\u0430\u0438\u0432\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442
      \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E\u0433\u043E \u0446\u0438\u043A\u043B\u0430.
      \u0412\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
      \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0441\u043E\u0437\u0434\u0430\u044E\u0442\u0441\u044F
      \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u044E\u0442\u0441\u044F
      \u043F\u043E \u043C\u0435\u0440\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
      \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067394
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0432 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438,
      \u043D\u043E \u043F\u043E\u0440\u043E\u0436\u0434\u0430\u0435\u0442 \u043B\u0438\u0448\u043D\u0438\u0435
      \u0430\u043B\u043B\u043E\u043A\u0430\u0446\u0438\u0438, churn \u043F\u043E
      transform \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u043D\u0430 \u0434\u0432\u0438\u0436\u043E\u043A
      \u043F\u0440\u0438 \u0440\u043E\u0441\u0442\u0435 \u0441\u0442\u0440\u0435\u0441\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 314689803067395
    m_Localized: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
