    m_Localized: "\u0421\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435 \u0430\u043B\u043B\u043E\u043A\u0430\u0446\u0438\u0438\n\u0411\u043E\u043B\u0435\u0435
