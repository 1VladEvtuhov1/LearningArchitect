      m_Items: []
  - m_Id: 314689798873099
    m_Localized: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 \u043D\u0430 utility-\u043E\u0446\u0435\u043D\u043A\u0435.
      \u0410\u0433\u0435\u043D\u0442\u044B \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
