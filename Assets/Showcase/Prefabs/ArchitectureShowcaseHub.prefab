--- !u!114 &6757411084471821554
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7236764998193620330}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FF8C3C><size=74%><b>ABOUT</b></size></color>\nChunk-based processing
    groups particles into spatial chunks to improve cache locality and reduce draw
    calls.\n\n<color=#FF8C3C><size=74%><b>ARCHITECTURE</b></size></color>\nBatched
    data-oriented variant. Stores positions and velocities in arrays and updates
    them with a simple for loop.\n\n<color=#FF8C3C><size=74%><b>TRADE-OFFS</b></size></color>\nMuch
    better scaling than per-object behaviour, but less direct to inspect in the hierarchy.\n\n<color=#22C55E><size=74%><b>PROS</b></size></color>\n\u2022
    One batched update loop\n\u2022 Simulates more effects than it renders\n\u2022
    Clearer path toward data-oriented optimization\n\n<color=#EF4444><size=74%><b>CONS</b></size></color>\n\u2022
    Less direct than object-per-effect\n\u2022 Needs custom visualization\n\u2022
    More bookkeeping than the indie variant"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
