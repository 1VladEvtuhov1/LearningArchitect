  _windowTitle: LearningArchitect Test Center
  _toolbarTitle: LearningArchitect Test Center
  _sessionStatePrefix: LearningArchitect.TestCenter.
  _resultsDirectoryRelativePath: Temp/TestResults
  _minWidth: 780
