    - _displayName: Module Contract Coverage
      _categoryName: LearningArchitect.Modules.Edit
      _mode: 2
      _resultFileName: LearningArchitect.Modules.Edit.xml
      _description: Module authoring rules, prefab wiring, and showcase-facing contract checks.
  - _title: Focused Logic
